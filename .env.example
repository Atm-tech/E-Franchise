# Copy to .env for Docker Compose. For direct Uvicorn, export these variables first.
APP_DOMAIN=partners.example.com
APP_ENV=production
SEED_DEMO=0
SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-long-password

# Optional Razorpay integration (use test-mode keys for acceptance testing first).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional SMS sender; Indian messaging registration/templates must be configured with provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional configured/self-hosted OSRM origin; never uses a public demo service automatically.
OSRM_ROUTING_URL=

# Device bridge contract: {"scale-id":{"secret":"unique-32-plus-character-secret","outlet_id":1}}
DEVICE_KEYS_JSON={}

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
