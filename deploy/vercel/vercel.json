{
  "framework": null,
  "rewrites": [
    {
      "destination": "https://aapoorti-e-franchise.onrender.com/:path*",
      "source": "/:path*"
    }
  ],
  "buildCommand": null,
  "headers": [
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ],
      "source": "/:path*"
    }
  ],
  "outputDirectory": "public",
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
