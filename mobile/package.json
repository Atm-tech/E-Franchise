    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capgo/background-geolocation": "^8.4.11",
    "esbuild": "^0.28.2",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@zxing/browser": "^0.2.1"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
