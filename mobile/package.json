{
  "name": "aapoorti-partner-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "configure": "node configure.mjs",
    "bundle:tracking": "esbuild background-geolocation-entry.js --bundle --platform=browser --format=iife --outfile=../app/static/vendor/background-geolocation.js",
